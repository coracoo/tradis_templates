{
  "id": 53,
  "sort_order": 50,
  "name": "dify",
  "category": "productivity",
  "description": "Dify 是开源的 LLM 应用开发平台，支持可视化编排工作流、RAG、Agent、模型管理，一键构建 AI 助手、知识库、工作流应用。",
  "version": "latest",
  "logo": "https://raw.githubusercontent.com/langgenius/dify/main/web/app/components/base/logo/logo-site.svg",
  "website": "https://github.com/langgenius/dify",
  "tutorial": "访问地址：http://服务器IP:80\n首次访问创建管理员账号。\n此为简化部署（api+web+worker+nginx+postgres+redis+weaviate）。\n数据库与向量数据持久化在 ./volumes 目录。",
  "dotenv": "SECRET_KEY=\nDB_PASSWORD=\n",
  "compose": "services:\n  nginx:\n    image: nginx:latest\n    restart: unless-stopped\n    depends_on: [api, web]\n    ports:\n      - \"80:80\"\n    volumes:\n      - ./volumes/nginx/conf.d:/etc/nginx/conf.d\n\n  api:\n    image: langgenius/dify-api:latest\n    restart: unless-stopped\n    depends_on: [db, redis]\n    volumes:\n      - ./volumes/app/storage:/app/api/storage\n    environment:\n      - SECRET_KEY=${SECRET_KEY}\n      - DB_USERNAME=postgres\n      - DB_PASSWORD=${DB_PASSWORD}\n      - DB_HOST=db\n      - DB_PORT=5432\n      - DB_DATABASE=dify\n      - REDIS_HOST=redis\n      - REDIS_PORT=6379\n      - VECTOR_STORE=weaviate\n      - WEAVIATE_ENDPOINT=http://weaviate:8080\n\n  worker:\n    image: langgenius/dify-api:latest\n    restart: unless-stopped\n    depends_on: [api]\n    command: celery -A app.celery worker -P gevent -c 1\n    environment:\n      - DB_USERNAME=postgres\n      - DB_PASSWORD=${DB_PASSWORD}\n      - DB_HOST=db\n      - DB_DATABASE=dify\n      - REDIS_HOST=redis\n\n  web:\n    image: langgenius/dify-web:latest\n    restart: unless-stopped\n\n  db:\n    image: postgres:15-alpine\n    restart: unless-stopped\n    volumes:\n      - ./volumes/db/data:/var/lib/postgresql/data\n    environment:\n      - POSTGRES_USER=postgres\n      - POSTGRES_PASSWORD=${DB_PASSWORD}\n      - POSTGRES_DB=dify\n\n  redis:\n    image: redis:7-alpine\n    restart: unless-stopped\n    volumes:\n      - ./volumes/redis/data:/data\n\n  weaviate:\n    image: semitechnologies/weaviate:1.24.4\n    restart: unless-stopped\n    volumes:\n      - ./volumes/weaviate:/var/lib/weaviate\n    environment:\n      - PERSISTENCE_DATA_PATH=/var/lib/weaviate\n      - AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=true",
