{
  "id": 52,
  "sort_order": 49,
  "name": "open-webui",
  "category": "productivity",
  "description": "Open WebUI（原 Ollama WebUI）是一个功能强大的自托管 LLM Web 界面，支持 Ollama、OpenAI 兼容 API，多用户、多模型、文档对话、RAG。",
  "version": "main",
  "logo": "https://raw.githubusercontent.com/open-webui/open-webui/main/static/favicon.png",
  "website": "https://github.com/open-webui/open-webui",
  "tutorial": "访问地址：http://服务器IP:3000\n可连接本地 Ollama（OLLAMA_BASE_URL）或 OpenAI 兼容接口。\n首次访问注册的首个用户即管理员。\n数据（用户、聊天、知识库）在 ./data。",
  "dotenv": "OPENAI_API_KEY=\n",
  "compose": "services:\n  open-webui:\n    image: ghcr.io/open-webui/open-webui:main\n    restart: unless-stopped\n    ports:\n      - \"3000:8080\"\n    volumes:\n      - ./data:/app/backend/data\n    environment:\n      - OLLAMA_BASE_URL=http://host.docker.internal:11434\n      - OPENAI_API_BASE_URL=https://api.openai.com/v1\n      - OPENAI_API_KEY=${OPENAI_API_KEY}\n      - WEBUI_AUTH=true",
