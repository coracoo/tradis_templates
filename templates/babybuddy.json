  "name": "babybuddy",
  "category": "hobby",
  "description": "BabyBuddy 是一款帮助父母追踪宝宝喂养、睡眠、换尿布、如厕、俯卧时间等日常活动的应用，提供图表与提醒。",
  "version": "latest",
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-babybuddy/master/logo/babybuddy.png",
  "website": "https://github.com/babybuddy/babybuddy",
  "tutorial": "访问地址：http://服务器IP:8000\n首次访问创建管理员账号。\n数据（SQLite）在 ./config。反代时需设置 CSRF_TRUSTED_ORIGINS。",
  "dotenv": "",
  "compose": "services:\n  babybuddy:\n    image: lscr.io/linuxserver/babybuddy:latest\n    restart: unless-stopped\n    ports:\n      - \"8000:8000\"\n    volumes:\n      - ./config:/config\n    environment:\n      - PUID=1000\n      - PGID=1000\n      - TZ=Asia/Shanghai\n      - CSRF_TRUSTED_ORIGINS=",
