{
  "id": 62,
  "sort_order": 59,
  "name": "gotify",
  "category": "other",
  "description": "Gotify 是一个自托发的推送通知服务器，通过简单的 HTTP API 发送消息到 Android/桌面客户端，适合自建通知/告警通道。",
  "version": "latest",
  "logo": "https://raw.githubusercontent.com/gotify/server/master/.github/logo.png",
  "website": "https://github.com/gotify/server",
  "tutorial": "访问地址：http://服务器IP:8380\n内置 SQLite，数据在 ./gotify-data。\n首次访问注册首个用户即管理员。\nAndroid 推送需 HTTPS，建议反代。",
  "dotenv": "",
  "compose": "services:\n  gotify:\n    image: gotify/server\n    restart: unless-stopped\n    ports:\n      - \"8380:80\"\n    volumes:\n      - ./gotify-data:/app/data",
