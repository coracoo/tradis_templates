{
  "id": 38,
  "sort_order": 35,
  "name": "netdata",
  "category": "other",
  "description": "Netdata 是高分辨率、实时系统监控工具，提供 CPU、内存、磁盘、网络、Docker、数据库等海量指标的实时可视化仪表盘。",
  "version": "stable",
  "logo": "https://raw.githubusercontent.com/netdata/netdata/master/docs/img/netdata-logo.svg",
  "website": "https://github.com/netdata/netdata",
  "tutorial": "访问地址：http://服务器IP:19999\n需较高权限（cap_add、pid: host）以采集宿主机指标。\n可选接入 Netdata Cloud：设置 NETDATA_CLAIM_TOKEN。",
  "dotenv": "",
  "compose": "services:\n  netdata:\n    image: netdata/netdata:stable\n    restart: unless-stopped\n    pid: host\n    cap_add:\n      - SYS_PTRACE\n      - SYS_ADMIN\n    security_opt:\n      - apparmor:unconfined\n    ports:\n      - \"19999:19999\"\n    volumes:\n      - netdataconfig:/etc/netdata\n      - netdatalib:/var/lib/netdata\n      - netdatacache:/var/cache/netdata\n      - /etc/passwd:/host/etc/passwd:ro\n      - /etc/group:/host/etc/group:ro\n      - /etc/os-release:/host/etc/os-release:ro\n      - /proc:/host/proc:ro\n      - /sys:/host/sys:ro\n      - /dev:/host/dev:ro\n      - /var/run/docker.sock:/var/run/docker.sock:ro\n    environment:\n      - NETDATA_CLAIM_TOKEN=\n      - NETDATA_CLAIM_URL=https://app.netdata.cloud\n      - NETDATA_CLAIM_ROOMS=\nvolumes:\n  netdataconfig:\n  netdatalib:\n  netdatacache:",
