  "compose": "services:\n  movieclaw:\n    image: movieclaw/movieclaw:latest\n    container_name: movieclaw\n    init: true\n    ports:\n      - \"31200:3000\"\n      - \"7359:7359/udp\"\n    volumes:\n      - ./data:/app/data\n      # 媒体盘挂载示例（按实际情况修改/增删）：\n      - ./movie:/media\n      # 下载器的保存目录也要以相同路径挂进来，movieclaw 才能对下载完成的文件做入库整理：\n      - .download:/downloads\n    environment:\n      - TZ=Asia/Shanghai\n      # - TMDB_API_KEY=你自己的key\n    restart: unless-stopped",
