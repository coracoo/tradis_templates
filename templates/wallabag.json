{
  "id": 50,
  "sort_order": 47,
  "name": "wallabag",
  "category": "knowledge",
  "description": "Wallabag 是一个自托管的「稍后阅读」应用，可保存网页文章正文、去除广告，支持离线阅读、标签、过滤、多客户端同步。",
  "version": "latest",
  "logo": "https://raw.githubusercontent.com/wallabag/wallabag/master/web/images/logo-icon.svg",
  "website": "https://github.com/wallabag/wallabag",
  "tutorial": "访问地址：http://服务器IP:8284\n默认账号 wallabag:wallabag，登录后立即修改。\n内置 SQLite（数据在 ./data），也可配 MariaDB/PostgreSQL。",
  "dotenv": "",
  "compose": "services:\n  wallabag:\n    image: wallabag/wallabag:latest\n    restart: unless-stopped\n    ports:\n      - \"8284:80\"\n    volumes:\n      - ./data:/var/www/wallabag/data\n      - ./images:/var/www/wallabag/web/assets/images\n    environment:\n      - SYMFONY__ENV__DOMAIN_NAME=http://localhost:8284\n      - SYMFONY__ENV__SERVER_NAME=Your Wallabag",
