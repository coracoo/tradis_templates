{
  "id": 37,
  "sort_order": 34,
  "name": "uptime-kuma",
  "category": "other",
  "description": "Uptime Kuma 是一个功能强大的自托管监控工具，支持 HTTP/HTTPS、TCP、Ping、DNS 等多种监控方式，提供精美的状态页面和丰富的通知渠道。",
  "version": "1",
  "logo": "https://raw.githubusercontent.com/louislam/uptime-kuma/master/public/icon.svg",
  "website": "https://github.com/louislam/uptime-kuma",
  "tutorial": "访问地址：http://服务器IP:3001\n首次进入需创建管理员账号。\n支持监控 HTTP(s)、TCP、Ping、DNS、Docker 容器等。\n内置 SQLite，数据存储在 /app/data。",
  "dotenv": "",
  "compose": "services:\n  uptime-kuma:\n    image: louislam/uptime-kuma:1\n    restart: unless-stopped\n    ports:\n      - \"3001:3001\"\n    volumes:\n      - ./uptime-kuma-data:/app/data",
