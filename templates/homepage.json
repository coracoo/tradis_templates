  "name": "homepage",
  "category": "other",
  "description": "Homepage 是一个高度可定制的现代仪表盘/导航主页，通过 YAML 配置，支持 Docker 集成、服务监控、书签、200000+ 图标，原生中文支持。",
  "version": "latest",
  "logo": "https://raw.githubusercontent.com/gethomepage/homepage/main/public/homepage-desktop.png",
  "website": "https://github.com/gethomepage/homepage",
  "tutorial": "访问地址：http://服务器IP:3000\n配置文件在 ./config 目录（settings.yaml、services.yaml、bookmarks.yaml、docker.yaml）。\n挂载 docker.sock 可自动发现容器。",
  "dotenv": "",
  "compose": "services:\n  homepage:\n    image: ghcr.io/gethomepage/homepage:latest\n    restart: unless-stopped\n    ports:\n      - \"3000:3000\"\n    volumes:\n      - ./config:/app/config\n      - /var/run/docker.sock:/var/run/docker.sock:ro\n    environment:\n      - PUID=1000\n      - PGID=1000",
