  "name": "wordpress-mysql",
  "category": "工具",
  "description": "WordPress 用于搭建博客和网站。模板包含 MariaDB，网站文件和数据库分别保存在项目目录中。",
  "version": "",
  "logo": "/assets/app-icons/wordpress.svg",
  "website": "https://wordpress.org/",
  "tutorial": "",
  "dotenv": "",
  "compose": "services:\n  db:\n    command: --default-authentication-plugin=mysql_native_password\n    environment:\n      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:?请填写数据库管理员密码}\n      MYSQL_DATABASE: wordpress\n      MYSQL_USER: wordpress\n      MYSQL_PASSWORD: ${DB_PASSWORD:?请填写应用数据库密码}\n    expose:\n    - 3306\n    - 33060\n    image: mariadb:10.6.4-focal\n    restart: always\n    volumes:\n    - ./db_data:/var/lib/mysql\n  wordpress:\n    environment:\n      WORDPRESS_DB_HOST: db\n      WORDPRESS_DB_USER: wordpress\n      WORDPRESS_DB_PASSWORD: ${DB_PASSWORD:?请填写应用数据库密码}\n      WORDPRESS_DB_NAME: wordpress\n    image: wordpress:latest\n    ports:\n    - 80:80\n    restart: always\n    volumes:\n    - ./wordpress:/var/www/html\n",
