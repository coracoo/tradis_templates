  "id": 251,
  "sort_order": 65,
  "name": "nowen_reader",
  "category": "entertainment",
  "description": "为漫画爱好者打造私域、可控、高效的个人漫画图书馆。",
  "version": "latest",
  "logo": "",
  "website": "https://github.com/cropflre/nowen-reader",
  "tutorial": "",
  "dotenv": "",
  "compose": "services:\n  nowen-reader:\n    image: cropflre/nowen-reader:latest\n    container_name: nowen-reader\n    restart: unless-stopped\n    ports:\n      - \"6680:3000\"\n    privileged: true\n    volumes:\n      - ./data:/data\n      - ./cache:/app/.cache        \n      # NAS 的漫画文件目录\n      - /volume1/comics:/app/comics\n      - /volume1/novels:/app/novels\n    environment:\n      - GIN_MODE=release\n      - DATABASE_URL=/data/nowen-reader.db\n      - COMICS_DIR=/app/comics\n      - NOVELS_DIR=/app/novels\n      - DATA_DIR=/app/.cache\n      - PORT=3000\n      - TZ=Asia/Shanghai",
