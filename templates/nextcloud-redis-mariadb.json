  ],
  "id": 263,
  "sort_order": 75,
  "name": "nextcloud-redis-mariadb",
  "category": "工具",
  "description": "Nextcloud 提供文件同步、分享和协作。这个部署组合使用 MariaDB 存储数据，并通过 Redis 提供缓存。",
  "version": "",
  "logo": "/assets/app-icons/nextcloud.svg",
  "website": "https://github.com/nextcloud/server",
  "tutorial": "",
  "dotenv": "",
  "compose": "networks:\n  dbnet: null\n  redisnet: null\nservices:\n  db:\n    command: --transaction-isolation=READ-COMMITTED --binlog-format=ROW\n    environment:\n      MYSQL_DATABASE: nextcloud\n      MYSQL_USER: nextcloud\n      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:?请填写数据库管理员密码}\n      MYSQL_PASSWORD: ${DB_PASSWORD:?请填写应用数据库密码}\n    expose:\n    - 3306\n    image: mariadb:10.5\n    networks:\n    - dbnet\n    restart: always\n    volumes:\n    - ./db_data:/var/lib/mysql\n  nc:\n    environment:\n      REDIS_HOST: redis\n      MYSQL_HOST: db\n      MYSQL_DATABASE: nextcloud\n      MYSQL_USER: nextcloud\n      MYSQL_PASSWORD: ${DB_PASSWORD:?请填写应用数据库密码}\n    image: nextcloud:apache\n    networks:\n    - redisnet\n    - dbnet\n    ports:\n    - 80:80\n    restart: always\n    volumes:\n    - ./nc_data:/var/www/html\n  redis:\n    expose:\n    - 6379\n    image: redis:alpine\n    networks:\n    - redisnet\n    restart: always\n",
