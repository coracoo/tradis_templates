  "compose": "services:\n    zeroclaw:\n        deploy:\n            resources:\n                limits:\n                    cpus: \"2\"\n                    memory: 512M\n                reservations:\n                    cpus: \"0.5\"\n                    memory: 32M\n        environment:\n            - ZEROCLAW_providers__models__openrouter__default__api_key=\n            - ZEROCLAW_gateway__host=0.0.0.0\n            - ZEROCLAW_gateway__allow_public_bind=true\n            - ZEROCLAW_gateway__port=42617\n        healthcheck:\n            interval: 60s\n            retries: 3\n            start_period: 10s\n            test:\n                - CMD\n                - zeroclaw\n                - status\n                - --format=exit-code\n            timeout: 10s\n        image: ghcr.io/zeroclaw-labs/zeroclaw:latest\n        ports:\n            - 127.0.0.1:42617:42617\n        restart: unless-stopped\n        volumes:\n            - source: zeroclaw-data\n              target: /zeroclaw-data\n              type: volume\nvolumes:\n    zeroclaw-data: null\n",
