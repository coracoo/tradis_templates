{
  "id": 40,
  "sort_order": 37,
  "name": "vaultwarden",
  "category": "network",
  "description": "Vaultwarden 是用 Rust 编写的轻量级 Bitwarden 服务器 API 实现，兼容官方 Bitwarden 客户端，内置 SQLite，资源占用极低。",
  "version": "latest",
  "logo": "https://raw.githubusercontent.com/dani-garcia/vaultwarden/main/resources/vaultwarden-icon.svg",
  "website": "https://github.com/dani-garcia/vaultwarden",
  "tutorial": "访问地址：http://服务器IP:80\n强烈建议通过反向代理启用 HTTPS（Bitwarden 客户端要求 TLS）。\n设置 DOMAIN 为你的访问地址，附件/邀请链接才正确。\n首次访问注册账号，建议关闭公开注册 SIGNUPS_ALLOWED=false。",
  "dotenv": "ADMIN_TOKEN=\n",
  "compose": "services:\n  vaultwarden:\n    image: vaultwarden/server:latest\n    restart: unless-stopped\n    ports:\n      - \"8080:80\"\n    volumes:\n      - ./vw-data:/data\n    environment:\n      - DOMAIN=https://bw.example.com\n      - SIGNUPS_ALLOWED=true\n      - ADMIN_TOKEN=${ADMIN_TOKEN}\n      - WEBSOCKET_ENABLED=true",
