  "id": 261,
  "sort_order": 77,
  "name": "webhook-site",
  "category": "工具",
  "description": "Various Docker Compose examples of selfhosted FOSS and proprietary projects.",
  "version": "",
  "logo": "",
  "website": "https://github.com/Haxxnet/Compose-Examples",
  "tutorial": "",
  "dotenv": "",
  "compose": "services:\n    laravel-echo-server:\n        environment:\n            - LARAVEL_ECHO_SERVER_AUTH_HOST=http://webhook\n            - LARAVEL_ECHO_SERVER_HOST=0.0.0.0\n            - LARAVEL_ECHO_SERVER_PORT=6001\n            - ECHO_REDIS_PORT=6379\n            - ECHO_REDIS_HOSTNAME=redis\n            - ECHO_PROTOCOL=http\n            - ECHO_ALLOW_CORS=true\n            - ECHO_ALLOW_ORIGIN=*\n            - ECHO_ALLOW_METHODS=*\n            - ECHO_ALLOW_HEADERS=*\n        image: webhooksite/laravel-echo-server\n        restart: unless-stopped\n    redis:\n        image: redis:alpine\n        restart: unless-stopped\n    webhook:\n        command: php artisan queue:work --daemon --tries=3 --timeout=10\n        depends_on:\n            - redis\n        environment:\n            - APP_ENV=dev\n            - APP_DEBUG=true\n            - APP_URL=http://localhost:8084\n            - APP_LOG=errorlog\n            - DB_CONNECTION=sqlite\n            - REDIS_HOST=redis\n            - BROADCAST_DRIVER=redis\n            - CACHE_DRIVER=redis\n            - QUEUE_DRIVER=redis\n            - ECHO_HOST_MODE=path\n        expose:\n            - 80\n        image: webhooksite/webhook.site\n        ports:\n            - 8084:80\n        restart: unless-stopped\n",
