{
  "id": 22,
  "name": "anynote",
  "category": "knowledge",
  "description": "一款功能强大的跨平台同步笔记应用，随时记录，支持 MAC、安卓、PC、WEB、Linux",
  "version": "latest",
  "logo": "https://anynote.online/rspress-icon.png",
  "website": "https://anynote.online/guide/index.html",
  "tutorial": "",
  "dotenv": "",
  "compose": "services:\n    anynote:\n        ports:\n            - 8080:8080\n        environment:\n            - secret=yourpassword\n        volumes:\n            - ./data:/data\n        image: anynoteofficial/anynote:latest",
  "screenshots": [
    "https://anynote.online/screenshot/loginpage.png"
  ],
  "schema": [
    {
      "name": "8080",
      "label": "8080",
      "description": "容器 WEB 端口",
      "type": "port",
      "default": "8080",
      "category": "basic",
      "serviceName": "anynote",
      "paramType": "port"
    },
    {
      "name": "./data",
      "label": "./data",
      "description": "容器持久化路径",
      "type": "path",
      "default": "/data",
      "category": "advanced",
      "serviceName": "anynote",
      "paramType": "path"
    },
    {
      "name": "secret",
      "label": "secret",
      "description": "修改为你的登录密码",
      "type": "password",
      "default": "yourpassword",
      "category": "basic",
      "serviceName": "anynote",
      "paramType": "env"
    }
  ],
  "enabled": true
}
