{
  "id": 41,
  "sort_order": 38,
  "name": "2fauth",
  "category": "network",
  "description": "2FAuth 是一个基于 Web 的双因素认证（2FA）管理器，用于管理、生成、验证 TOTP/HOTP 验证码，自托管保护你的账户安全。",
  "version": "latest",
  "logo": "https://raw.githubusercontent.com/Bubka/2FAuth/main/public/images/logo.png",
  "website": "https://github.com/Bubka/2FAuth",
  "tutorial": "访问地址：http://服务器IP:8000\n内置 SQLite，数据在 ./2fauth 目录。\nAPPLICATION_KEY 必须保持不变（Laravel APP_KEY），否则会话失效。\n首次访问注册管理员账号。",
  "dotenv": "APPLICATION_KEY=\n",
  "compose": "services:\n  2fauth:\n    image: 2fauth/2fauth:latest\n    restart: unless-stopped\n    ports:\n      - \"8000:8000\"\n    volumes:\n      - ./2fauth:/2fauth\n    environment:\n      - APP_URL=http://localhost:8000\n      - APPLICATION_KEY=${APPLICATION_KEY}\n      - SITE_NAME=2FAuth\n      - AUTHENTICATION_GUARD=web-guard\n      - DB_DATABASE=/2fauth/database/database.sqlite",
