{
  "id": 61,
  "sort_order": 58,
  "name": "umami",
  "category": "other",
  "description": "Umami 是一个开源、隐私友好的网站分析工具，是 Google Analytics 的轻量替代，提供页面浏览、访客、事件、来源等统计。",
  "version": "postgresql-latest",
  "logo": "https://raw.githubusercontent.com/umami-software/umami/master/public/favicon.ico",
  "website": "https://github.com/umami-software/umami",
  "tutorial": "访问地址：http://服务器IP:3001\n需搭配 PostgreSQL 数据库。\n默认账号 admin / umami，登录后立即修改密码。\n分析数据全部存在数据库中。",
  "dotenv": "APP_SECRET=\nDB_PASSWORD=\n",
  "compose": "services:\n  umami:\n    image: ghcr.io/umami-software/umami:postgresql-latest\n    restart: unless-stopped\n    depends_on: [db]\n    ports:\n      - \"3001:3000\"\n    environment:\n      - DATABASE_URL=postgresql://umami:${DB_PASSWORD}@db:5432/umami\n      - DATABASE_TYPE=postgresql\n      - APP_SECRET=${APP_SECRET}\n\n  db:\n    image: postgres:15-alpine\n    restart: unless-stopped\n    volumes:\n      - ./umami-db:/var/lib/postgresql/data\n    environment:\n      - POSTGRES_DB=umami\n      - POSTGRES_USER=umami\n      - POSTGRES_PASSWORD=${DB_PASSWORD}",
