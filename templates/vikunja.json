{
  "id": 60,
  "sort_order": 57,
  "name": "vikunja",
  "category": "productivity",
  "description": "Vikunja 是一款自托管的待办与任务管理应用，类似 Todoist，支持列表、命名空间、看板、提醒、团队协作，内置 SQLite。",
  "version": "latest",
  "logo": "https://raw.githubusercontent.com/go-vikunja/vikunja/main/public/favicon.ico",
  "website": "https://github.com/go-vikunja/vikunja",
  "tutorial": "访问地址：http://服务器IP:3456\n内置 SQLite，数据在 ./files。\n首次访问注册首个用户即管理员。\nVIKUNJA_SERVICE_JWTSECRET 需保持不变。",
  "dotenv": "JWTSECRET=\n",
  "compose": "services:\n  vikunja:\n    image: vikunja/vikunja:latest\n    restart: unless-stopped\n    ports:\n      - \"3456:3456\"\n    volumes:\n      - ./files:/app/vikunja/files\n    environment:\n      - VIKUNJA_SERVICE_JWTSECRET=${JWTSECRET}\n      - VIKUNJA_SERVICE_PUBLICURL=http://localhost:3456\n      - VIKUNJA_DATABASE_PATH=/app/vikunja/files/vikunja.db",
