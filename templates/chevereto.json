  ],
  "id": 252,
  "sort_order": 68,
  "name": "chevereto",
  "category": "工具",
  "description": "Chevereto 是自托管图床，支持管理图片、创建相册并生成分享链接。",
  "version": "",
  "logo": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons@57e939e504eda0ea764098015da93aa666ad6f31/svg/chevereto.svg",
  "website": "https://github.com/chevereto/chevereto",
  "tutorial": "",
  "dotenv": "",
  "compose": "services:\n  chevereto:\n    environment:\n      CHEVERETO_ASSET_STORAGE_BUCKET: /var/www/html/images/_assets\n      CHEVERETO_ASSET_STORAGE_TYPE: local\n      CHEVERETO_ASSET_STORAGE_URL: /images/_assets\n      CHEVERETO_DB_HOST: mariadb\n      CHEVERETO_DB_NAME: chevereto\n      CHEVERETO_DB_PASS: ${MYSQL_PASSWORD:?MYSQL_PASSWORD is required}\n      CHEVERETO_DB_PORT: 3306\n      CHEVERETO_DB_USER: chevereto\n    expose:\n    - 80\n    image: ghcr.io/chevereto/chevereto:4.4\n    init: true\n    ports:\n    - 8999:80\n    restart: unless-stopped\n    volumes:\n    - ./chevereto:/var/www/html/images\n  mariadb:\n    environment:\n      MARIADB_ROOT_PASSWORD: ${MARIADB_ROOT_PASSWORD:?MARIADB_ROOT_PASSWORD is required}\n      MYSQL_DATABASE: chevereto\n      MYSQL_PASSWORD: ${MYSQL_PASSWORD:?MYSQL_PASSWORD is required}\n      MYSQL_USER: chevereto\n    expose:\n    - 3306\n    image: mariadb\n    init: true\n    restart: unless-stopped\n    volumes:\n    - ./chevereto_mariadb:/var/lib/mysql\n",
