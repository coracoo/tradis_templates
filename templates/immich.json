{
  "id": 64,
  "sort_order": 61,
  "name": "immich",
  "category": "photos",
  "description": "Immich 是一款高性能的自托管照片与视频备份方案，类似 Google 相册，提供自动备份、人脸识别、搜索、相册、共享，多端客户端。",
  "version": "release",
  "logo": "https://raw.githubusercontent.com/immich-app/immich/main/design/immich-logo.svg",
  "website": "https://github.com/immich-app/immich",
  "tutorial": "访问地址：http://服务器IP:2283\n首次访问注册管理员账号。\n此为简化部署（server + machine-learning + postgres + redis）。\n上传文件与数据库在 ./library、./upload、./pgdata。\n机器学习模型首次启动会自动下载。",
  "dotenv": "DB_PASSWORD=\n",
  "compose": "services:\n  immich-server:\n    image: ghcr.io/immich-app/immich-server:release\n    restart: unless-stopped\n    depends_on: [redis, database]\n    ports:\n      - \"2283:2283\"\n    volumes:\n      - ./upload:/usr/src/app/upload\n      - ./library:/usr/src/app/library\n      - /etc/localtime:/etc/localtime:ro\n    environment:\n      - DB_HOSTNAME=database\n      - DB_USERNAME=postgres\n      - DB_PASSWORD=${DB_PASSWORD}\n      - DB_DATABASE_NAME=immich\n      - REDIS_HOSTNAME=redis\n\n  immich-machine-learning:\n    image: ghcr.io/immich-app/immich-machine-learning:release\n    restart: unless-stopped\n    volumes:\n      - ./model-cache:/cache\n\n  redis:\n    image: redis:6-alpine\n    restart: unless-stopped\n\n  database:\n    image: tensorchord/pgvecto-rs:pg16\n    restart: unless-stopped\n    environment:\n      - POSTGRES_PASSWORD=${DB_PASSWORD}\n      - POSTGRES_USER=postgres\n      - POSTGRES_DB=immich\n    volumes:\n      - ./pgdata:/var/lib/postgresql/data",
