{
  "id": 36,
  "sort_order": 33,
  "name": "watchtower",
  "category": "other",
  "description": "Watchtower 是一个容器自动更新服务，可监控运行中的 Docker 容器镜像，发现新版本时自动拉取并重建容器。",
  "version": "latest",
  "logo": "https://containrrr.dev/watchtower/images/logo-450px.png",
  "website": "https://github.com/containrrr/watchtower",
  "tutorial": "Watchtower 无 Web 界面，运行后自动按计划（默认每 24 小时）检查镜像更新。\n通过环境变量 WATCHTOWER_SCHEDULE 设置 cron（6 字段，含秒）。\n需挂载 docker.sock。",
  "dotenv": "",
  "compose": "services:\n  watchtower:\n    image: containrrr/watchtower:latest\n    restart: unless-stopped\n    volumes:\n      - /var/run/docker.sock:/var/run/docker.sock\n    environment:\n      - WATCHTOWER_SCHEDULE=0 0 4 * * *\n      - WATCHTOWER_CLEANUP=true\n      - WATCHTOWER_NOTIFICATIONS=shoutrrr",
