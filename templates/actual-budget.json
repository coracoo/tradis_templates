  "name": "actual-budget",
  "category": "hobby",
  "description": "Actual Budget 是一款开源的本地优先个人预算应用，支持预算规划、账户同步、加密同步，提供强大的预算工作流。",
  "version": "latest",
  "logo": "https://raw.githubusercontent.com/actualbudget/actual/master/packages/desktop-client/public/icons/favicon-512.png",
  "website": "https://github.com/actualbudget/actual",
  "tutorial": "访问地址：http://服务器IP:5006\n首次访问创建管理员账号。\n所有预算数据与加密密钥在 ./actual-data，务必备份。\n本地优先架构，服务器只做同步。",
  "dotenv": "",
  "compose": "services:\n  actual-server:\n    image: actualbudget/actual-server:latest\n    restart: unless-stopped\n    ports:\n      - \"5006:5006\"\n    volumes:\n      - ./actual-data:/data",
