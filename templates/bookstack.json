{
  "id": 48,
  "sort_order": 45,
  "name": "bookstack",
  "category": "knowledge",
  "description": "BookStack 是一个简单、自托管的文档/Wiki 平台，提供直观的书籍-章节-页面层级组织，支持 Markdown、WYSIWYG 编辑、权限管理。",
  "version": "latest",
  "logo": "https://www.bookstackapp.com/images/logo.png",
  "website": "https://github.com/solidnerd/docker-bookstack",
  "tutorial": "访问地址：http://服务器IP:6875\n需搭配 MariaDB 数据库容器。\n首次登录账号 admin@admin.com / password，登录后立即修改密码。",
  "dotenv": "DB_PASS=\n",
  "compose": "services:\n  bookstack:\n    image: lscr.io/linuxserver/bookstack:latest\n    restart: unless-stopped\n    depends_on:\n      - bookstack_db\n    ports:\n      - \"6875:80\"\n    volumes:\n      - ./bookstack-data:/config\n    environment:\n      - DB_HOST=bookstack_db\n      - DB_USER=bookstack\n      - DB_PASS=${DB_PASS}\n      - DB_DATABASE=bookstackapp\n      - APP_URL=http://localhost:6875\n\n  bookstack_db:\n    image: lscr.io/linuxserver/mariadb:latest\n    restart: unless-stopped\n    volumes:\n      - ./bookstack-db:/config\n    environment:\n      - MYSQL_ROOT_PASSWORD=${DB_PASS}\n      - MYSQL_DATABASE=bookstackapp\n      - MYSQL_USER=bookstack\n      - MYSQL_PASSWORD=${DB_PASS}",
