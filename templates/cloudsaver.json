  "name": "cloudsaver",
  "category": "entertainment",
  "description": "一个基于 Vue 3 + Express 的网盘资源搜索与转存工具。",
  "version": "latest",
  "logo": "https://github.com/jiangrui1994/CloudSaver/blob/main/frontend/src/assets/images/logo.png?raw=true",
