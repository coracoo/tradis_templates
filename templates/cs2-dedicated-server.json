  "compose": "services:\n    cs2-rconpanel:\n        environment:\n            - USERNAME=cspanel\n            - PASSWORD=v67ic55x4ghvjfj\n        image: ghcr.io/l4rm4nd/cs2-rcon-panel:latest\n        ports:\n            - 3000:3000\n        restart: unless-stopped\n    cs2-server:\n        environment:\n            - SRCDS_TOKEN=\u003cYOUR-GAME-SERVER-TOKEN\u003e\n            - CS2_SERVERNAME=MY-CS2-SERVER\n            - CS2_CHEATS=0\n            - CS2_PORT=27015\n            - CS2_SERVER_HIBERNATE=0\n            - CS2_LAN=0\n            - CS2_RCONPW=cruelly-sequel-dejected\n            - CS2_PW=sake-earthly-lair\n            - CS2_MAXPLAYERS=10\n            - CS2_GAMEALIAS=competitive\n            - CS2_GAMETYPE=0\n            - CS2_GAMEMODE=1\n            - CS2_MAPGROUP=mg_active\n            - CS2_STARTMAP=de_dust2\n            - CS2_BOT_DIFFICULTY=0\n            - CS2_BOT_QUOTA=0\n            - CS2_BOT_QUOTA_MODE=competitive\n            - TV_AUTORECORD=0\n            - TV_ENABLE=0\n            - TV_PORT=27020\n            - TV_PW=changeme\n            - TV_RELAY_PW=changeme\n            - TV_MAXRATE=0\n            - TV_DELAY=0\n        image: joedwards32/cs2\n        ports:\n            - 27015:27015/tcp\n            - 27015:27015/udp\n        restart: unless-stopped\n        volumes:\n            - source: cs2\n              target: /home/steam/cs2-dedicated/\n              type: volume\nvolumes:\n    cs2: null\n",
