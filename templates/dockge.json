{
  "id": 35,
  "sort_order": 32,
  "name": "dockge",
  "category": "other",
  "description": "Dockge 是一个易于使用、响应式的 Docker Compose YAML 文件管理工具，由 Uptime Kuma 作者开发。可视化管理 compose 堆栈，支持编辑、启动、停止、查看日志。",
  "version": "1",
  "logo": "https://raw.githubusercontent.com/louislam/dockge/master/docker/icon.svg",
  "website": "https://github.com/louislam/dockge",
  "tutorial": "访问地址：http://服务器IP:5001\n首次进入需创建管理员账号。\n所有 compose 堆栈需放在 /opt/stacks 目录下，Dockge 才能管理它们。\n需挂载 docker.sock 才能管理宿主机的容器。",
  "dotenv": "",
  "compose": "services:\n  dockge:\n    image: louislam/dockge:1\n    restart: unless-stopped\n    ports:\n      - \"5001:5001\"\n    volumes:\n      - /var/run/docker.sock:/var/run/docker.sock\n      - ./data:/app/data\n      - /opt/stacks:/opt/stacks\n    environment:\n      - DOCKGE_STACKS_DIR=/opt/stacks",
