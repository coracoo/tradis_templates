{
  "id": 43,
  "sort_order": 40,
  "name": "audiobookshelf",
  "category": "entertainment",
  "description": "Audiobookshelf 是一个自托管的有声书和播客媒体服务器，支持元数据管理、播放进度同步、用户管理，提供 iOS/Android 客户端。",
  "version": "latest",
  "logo": "https://raw.githubusercontent.com/advplyr/audiobookshelf/master/static/Logo.svg",
  "website": "https://github.com/advplyr/audiobookshelf",
  "tutorial": "访问地址：http://服务器IP:13378\n容器内部端口为 80。\n有声书放入 ./audiobooks，播客放入 ./podcasts。\n配置和元数据分别存于 ./config 和 ./metadata。\n首次访问创建管理员账号。",
  "dotenv": "",
  "compose": "services:\n  audiobookshelf:\n    image: ghcr.io/advplyr/audiobookshelf:latest\n    restart: unless-stopped\n    ports:\n      - \"13378:80\"\n    volumes:\n      - ./audiobooks:/audiobooks\n      - ./podcasts:/podcasts\n      - ./metadata:/metadata\n      - ./config:/config",
