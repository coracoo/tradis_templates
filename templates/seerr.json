  "name": "seerr",
  "category": "entertainment",
  "description": "Seerr 是一款免费开源的软件应用程序，用于管理媒体库的请求。它可以与您选择的媒体服务器集成，例如 Jellyfin 、 Plex 和 Emby 。此外，它还可以与您现有的服务集成，例如 Sonarr 和 Radarr 。",
  "version": "latest",
  "logo": "https://avatars.githubusercontent.com/u/101442446?s=48\u0026v=4",
  "website": "https://github.com/seerr-team/seerr",
  "tutorial": "",
  "dotenv": "",
  "compose": "services:\n  jellyseerr:\n    image: fallenbagel/jellyseerr:latest\n    container_name: jellyseerr\n    environment:\n      - LOG_LEVEL=debug\n      - TZ=Asia/Shanghai\n      - PORT=7688\n    ports:\n      - 7688:7688\n    volumes:\n      - ./config:/app/config\n    restart: unless-stopped",
