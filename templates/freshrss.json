{
  "id": 49,
  "sort_order": 46,
  "name": "freshrss",
  "category": "knowledge",
  "description": "FreshRSS 是一个功能丰富、自托管的 RSS 阅读器，支持订阅、过滤、全文搜索、多用户，兼容 Google Reader / Fever API。",
  "version": "latest",
  "logo": "https://raw.githubusercontent.com/FreshRSS/FreshRSS/master/docs/img/FreshRSS-logo.png",
  "website": "https://github.com/FreshRSS/FreshRSS",
  "tutorial": "访问地址：http://服务器IP:8080\n默认 SQLite 存储，数据在 ./data。\n首次访问按向导完成配置并创建账号。\n兼容 Reeder、FeedMe 等客户端。",
  "dotenv": "",
  "compose": "services:\n  freshrss:\n    image: freshrss/freshrss:latest\n    restart: unless-stopped\n    ports:\n      - \"8282:80\"\n    volumes:\n      - ./data:/var/www/FreshRSS/data\n      - ./extensions:/var/www/FreshRSS/extensions\n    environment:\n      - CRON_MIN=*/10\n      - TZ=Asia/Shanghai",
